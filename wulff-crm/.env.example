# Wulff Relationship CRM — variáveis de ambiente
#
# Copie este arquivo para `.env` (desenvolvimento local) e configure as mesmas
# variáveis no painel do Netlify (Site settings → Environment variables).
#
# Onde encontrar: painel do Supabase → Project Settings → API
# - Project URL  → VITE_SUPABASE_URL
# - anon public  → VITE_SUPABASE_ANON_KEY
#
# ATENÇÃO: use somente a chave "anon public". NUNCA use a "service_role" no front-end.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-public
